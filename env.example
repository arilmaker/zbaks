# Salin file ini menjadi .env (hanya untuk localhost/Pterodactyl/VPS).
# Di Vercel, isi nilai-nilai ini lewat Settings > Environment Variables.

# Kontak admin untuk halaman "API Key" (nomor tanpa + dan spasi)
ADMIN_WHATSAPP=6285892370690
TELEGRAM_BOT_URL=https://t.me/username_bot

# Token rahasia untuk endpoint admin (buat/nonaktifkan key lewat bot). Kosongkan jika tidak dipakai.
ADMIN_BOT_TOKEN=ganti-token-rahasia-bot

# Key tambahan tanpa edit apikey.json, dipisah koma (paling mudah di Vercel)
# API_KEYS=rilz_contoh1,rilz_contoh2

# Port (Pterodactyl mengisi SERVER_PORT otomatis)
PORT=3000

# Opsional: lokasi apikey.json. Bawaan: apikey.json di samping server.js.
# APIKEY_PATH=/home/container/data/apikey.json

# Opsional: metadata artis dari Spotify (tanpa ini otomatis pakai Deezer + iTunes)
# Buat di https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
